<!DOCTYPE html>
<html>
  <head>
    <base target="_top">
    <style>
      body { font-family: Arial, sans-serif; padding: 15px; color: #333; }
      .field { margin-bottom: 15px; }
      label { display: block; font-weight: bold; margin-bottom: 5px; font-size: 13px; }
      select, input { width: 100%; padding: 8px; box-sizing: border-box; border: 1px solid #ccc; border-radius: 4px; }
      .btn-container { text-align: right; margin-top: 20px; }
      button { background-color: #1b5e20; color: white; border: none; padding: 10px 18px; font-weight: bold; border-radius: 4px; cursor: pointer; }
      button:hover { background-color: #144417; }
      #loading { display: none; margin-top: 10px; font-size: 12px; color: #666; font-style: italic; }
    </style>
  </head>
  <body>
    <h3>📊 Relatório Mensal de Postagens</h3>
    <div class="field">
      <label for="mes">Mês:</label>
      <select id="mes">
        <option value="01">Janeiro</option>
        <option value="02">Fevereiro</option>
        <option value="03">Março</option>
        <option value="04">Abril</option>
        <option value="05">Maio</option>
        <option value="06">Junho</option>
        <option value="07">Julho</option>
        <option value="08" selected>Agosto</option>
        <option value="09">Setembro</option>
        <option value="10">Outubro</option>
        <option value="11">Novembro</option>
        <option value="12">Dezembro</option>
      </select>
    </div>
    <div class="field">
      <label for="ano">Ano:</label>
      <input type="number" id="ano" value="2026">
    </div>
    <div id="loading">Contabilizando postagens... aguarde.</div>
    <div class="btn-container">
      <button onclick="gerarRelatorio()">Gerar Relatório</button>
    </div>

    <script>
      function gerarRelatorio() {
        const mes = document.getElementById('mes').value;
        const ano = document.getElementById('ano').value;
        
        if (!ano) {
          alert('Por favor, informe o ano.');
          return;
        }

        document.getElementById('loading').style.display = 'block';

        google.script.run
          .withSuccessHandler(() => {
            google.script.host.close();
          })
          .withFailureHandler((err) => {
            alert('Erro: ' + err.message);
            document.getElementById('loading').style.display = 'none';
          })
          .gerarRelatorioMensal(mes, ano);
      }
    </script>
  </body>
</html>
